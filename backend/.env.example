# Generate a new random value for each deployment. Never commit the real .env.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=data/smartcivic.db
UPLOAD_FOLDER=uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=30
OVERDUE_AFTER_HOURS=72
UNACCEPTED_AFTER_HOURS=24
OVERDUE_REMINDER_INTERVAL_SECONDS=3600
ETA_FALLBACK_HOURS=72
ML_CONFIDENCE_THRESHOLD=0.55

# MSG91 Flow API configuration. For India, configure the Flow template with the
# matching DLT template, registered sender/header, and principal entity (PE) ID.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_DLT_PE_ID=
MSG91_DLT_TEMPLATE_ID=

# Brevo transactional email. Use a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SmartCivicAI
